# Скопируй этот файл в .env.local и впиши реальные значения.
# .env.local в гит НЕ попадает (см. .gitignore). Секреты в чат не вставляй.

# Sanity (CMS)
NEXT_PUBLIC_SANITY_PROJECT_ID=ogu6ewxe
NEXT_PUBLIC_SANITY_DATASET=production
# Токен нужен ТОЛЬКО для скрипта импорта (право на запись). В .env.local, не в код.
SANITY_API_TOKEN=

# Заявки с форм.
# Основной канал — Sanity: заявка ложится в Studio разделом «Заявка с сайта».
# Нужен токен с правом записи (Editor). На сервере задаётся в переменных
# окружения Timeweb, локально — здесь. Если не задан, берётся SANITY_API_TOKEN.
SANITY_WRITE_TOKEN=

# Telegram — второй канал. С российского хостинга api.telegram.org недоступен,
# поэтому заявки туда не доходят; оставлено на случай, если доступ появится.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Страховка: файл, куда дублируются заявки. По умолчанию leads.log в корне.
LEADS_FILE=

# Секрет для мгновенного обновления сайта из CMS.
# Придумай длинную случайную строку и впиши её же в вебхуке Sanity.
REVALIDATE_SECRET=
